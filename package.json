{
  "name": "windrise-server",
  "version": "1.0.0",
  "description": "Production-ready REST API server for Windrise",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "overrides": {
    "jsdom": "26.1.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "build": "npm run db:generate && tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate --schema=./prisma/schema",
    "db:migrate": "prisma migrate --schema=./prisma/schema",
    "db:push": "prisma db push --schema=./prisma/schema",
    "db:pull": "prisma db pull --schema=./prisma/schema",
    "db:studio": "prisma studio --schema=./prisma/schema",
    "postinstall": "prisma generate --schema=./prisma/schema",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.10.0",
    "@types/ejs": "^3.1.5",
    "@types/http-status-codes": "^1.2.0",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.19.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^6.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^7.1.0",
    "http-status": "^1.7.4",
    "http-status-code": "^2.1.0",
    "http-status-codes": "^2.3.0",
    "isomorphic-dompurify": "^3.19.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.15",
    "openai": "^7.0.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.0",
    "@types/nodemailer": "^6.4.16",
    "prisma": "^8.0.0-rc.13",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  }
}
